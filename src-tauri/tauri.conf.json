{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quota Codex",
  "version": "1.1.5",
  "identifier": "com.mathiasbunnens.chatgpt-quota-monitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBQTI2NTczN0E5NjZBMjkKUldRcGFwWjZjMldpdWkreFNocE9zMm51c29PSndXZDBnNGhUYXVOWlBKWTlvcHFRT2dQQWNEc3kK",
      "endpoints": [
        "https://github.com/mathiasbunnens/chatgpt-quota-monitor/releases/latest/download/latest.json"
      ]
    }
  }
}
